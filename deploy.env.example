# Copy to deploy.env ON THE SERVER and fill in the empty values.
# Keep this file private (chmod 600 deploy.env). It is not the development env.
# Use 64-character random hexadecimal secrets, e.g. openssl rand -hex 32.
DB_PASSWORD=
API_ACCESS_KEY=
# Optional: leave empty to disable administrative HTTP endpoints.
ADMIN_API_KEY=

# Hostname only, without https:// or a path. A free example is:
# banks.YOUR_PUBLIC_IPV4.sslip.io
API_DOMAIN=
TLS_EMAIL=

# Next.js makes server-to-server requests; browser CORS is not required.
CORS_ORIGINS=
SCRAPING_INTERVAL_SECONDS=86400
