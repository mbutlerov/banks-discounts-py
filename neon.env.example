# Copy to neon.env at the repository root; that file is ignored by Git.
# Use the DIRECT Neon endpoint (no -pooler); the scraper uses session locks.
# Render and this local CLI must point to the same Neon project/database.
ENV=neon
DB_HOST=
DB_PORT=5432
DB_NAME=neondb
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Local CLI does not serve HTTP or need API/administrative access keys.
API_ACCESS_KEY=
REQUIRE_API_ACCESS_KEY=false
ADMIN_API_KEY=
CORS_ORIGINS=
ENABLE_AI_ENRICHMENT=false
SCRAPING_BANKS=ueno,sudameris,itau,atlas,gnb
SCRAPING_INTERVAL_SECONDS=86400
SCRAPING_TIMEOUT_SECONDS=1800
SCRAPING_MAX_DOCUMENTS=1500
SCRAPING_MAX_DETAILS_PER_BANK=600
SCRAPING_RETIRE_MISSING=false
PUBLIC_TIMEZONE=America/Asuncion
